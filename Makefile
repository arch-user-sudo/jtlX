.POSIX:
.SUFFIXES:

include config.mk

# flags for compiling
DWLCPPFLAGS = -I. -DWLR_USE_UNSTABLE -D_POSIX_C_SOURCE=200809L \
	-DVERSION=\"$(VERSION)\" $(XWAYLAND) $(FULLSCREEN_TEARING) $(FOREIGN_TOPLEVEL) $(WORKSPACES) $(X11_BACKEND) $(VULKAN)
DWLDEVCFLAGS = -g -Wpedantic -Wall -Wextra -Wdeclaration-after-statement \
	-Wno-unused-parameter -Wshadow -Wunused-macros -Werror=strict-prototypes \
	-Werror=implicit -Werror=return-type -Werror=incompatible-pointer-types \
	-Wfloat-conversion -Wimplicit-fallthrough

# CFLAGS / LDFLAGS.  wlroots is inlined into wlroots.c (generated by
# amalgamate.py) rather than linked, so the link line only needs wlroots'
# own system deps.
PKGS      = wayland-server xkbcommon libinput pixman-1 libdrm egl gbm glesv2 \
	lcms2 libudev libseat libdisplay-info libliftoff wayland-client \
	xcb xcb-dri3 xcb-present xcb-render xcb-renderutil xcb-shm xcb-xfixes \
	xcb-xinput xcb-composite xcb-ewmh xcb-icccm xcb-res xcb-shape $(XLIBS) $(VULKAN_LIBS)
DWLCFLAGS = `$(PKG_CONFIG) --cflags $(PKGS)` $(WLR_INCS) $(DWLCPPFLAGS) $(DWLDEVCFLAGS) $(CFLAGS)
LDLIBS    = `$(PKG_CONFIG) --libs $(PKGS)` $(WLR_LIBS) -lm $(LIBS)

# The generated wlroots source and the tooling that produces it.  jtl.c is the
# hand-written source; it includes wlroots.c, which amalgamate.py rebuilds from
# the wlroots/ tree + config.mk (amalgamate.py regenerates wlroots.c only while
# wlroots/ still exists; once it is gone the existing wlroots.c is kept).
AMALG = amalgamate.py
SCAN  = scan.py

# clang-tidy auto-fix pass run on wlroots.c right after it is regenerated and
# before anything compiles it.  Only checks with safe, semantics-preserving
# fix-its are enabled; the big conversion checks (-Wconversion etc.) have no
# auto-fixes and are deliberately absent.  Skipped automatically if clang-tidy
# is not installed.  Set TIDY= (empty) to disable.
TIDY        = clang-tidy
TIDY_CHECKS = -*,bugprone-macro-parentheses,bugprone-macro-repeated-side-effects,performance-type-promotion-in-math-fn,readability-inconsistent-declaration-parameter-name

# Canned recipe: the clang-tidy auto-fix pass (used by both wlroots.c rules).
# header-filter matches nothing on purpose: wlroots.c is self-contained (all
# project headers are inlined into it), so fixes must land in wlroots.c itself
# and never in system headers like pixman.h or drm_fourcc.h.
define tidy_wlroots
	@if [ -n "$(TIDY)" ] && command -v $(TIDY) >/dev/null 2>&1; then \
		echo "clang-tidy: auto-fixing wlroots.c"; \
		$(TIDY) -quiet -fix -checks='$(TIDY_CHECKS)' \
			--header-filter='a^' wlroots.c -- \
			$(DWLCPPFLAGS) `$(PKG_CONFIG) --cflags $(PKGS)` || exit 1; \
	else \
		echo "clang-tidy not found; skipping wlroots.c auto-fix pass"; \
	fi
endef

all: jtl
jtl: jtl.o
	$(CC) jtl.o $(DWLCFLAGS) $(LDFLAGS) $(LDLIBS) -o $@
jtl.o: jtl.c wlroots.c config.h config.mk

wlroots.c: jtl.c config.mk $(AMALG) $(SCAN)
	python3 $(AMALG)
	$(tidy_wlroots)

# Re-run the tidy auto-fix pass on the existing wlroots.c without regenerating.
tidy-wlroots: wlroots.c
	$(TIDY) -quiet -fix -checks='$(TIDY_CHECKS)' wlroots.c -- \
		$(DWLCPPFLAGS) `$(PKG_CONFIG) --cflags $(PKGS)`

# Force a regeneration even if wlroots.c looks up to date.
amalgamate:
	python3 $(AMALG)
	$(tidy_wlroots)

config.h:
	cp config.def.h $@

clean:
	rm -f jtl *.o

dist: clean
	mkdir -p jtl-$(VERSION)
	cp -R LICENSE* Makefile CHANGELOG.md README.md config.def.h \
		config.mk jtl.c wlroots.c amalgamate.py scan.py jtl.desktop \
		jtl-$(VERSION)
	tar -caf jtl-$(VERSION).tar.gz jtl-$(VERSION)
	rm -rf jtl-$(VERSION)

install: jtl
	mkdir -p $(DESTDIR)$(PREFIX)/bin
	rm -f $(DESTDIR)$(PREFIX)/bin/jtl
	cp -f jtl $(DESTDIR)$(PREFIX)/bin
	chmod 755 $(DESTDIR)$(PREFIX)/bin/jtl
	mkdir -p $(DESTDIR)$(DATADIR)/wayland-sessions
	cp -f jtl.desktop $(DESTDIR)$(DATADIR)/wayland-sessions/jtl.desktop
	chmod 644 $(DESTDIR)$(DATADIR)/wayland-sessions/jtl.desktop
uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/jtl \
		$(DESTDIR)$(DATADIR)/wayland-sessions/jtl.desktop

.PHONY: all clean amalgamate tidy-wlroots install uninstall dist

.SUFFIXES: .c .o
.c.o:
	$(CC) $(CPPFLAGS) $(DWLCFLAGS) -o $@ -c $<
